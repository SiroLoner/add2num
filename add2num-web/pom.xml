<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.caesar.add2num</groupId>
    <artifactId>add2num-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>add2num-web</artifactId>
  <packaging>jar</packaging>

  <name>Add2Num :: Web</name>
  <description>
    TASK 2 - Ung dung web cho phep nguoi dung cong hai so lon va xem tien trinh tinh toan.
    Tai su dung TASK 1 duoi dang sub-module Maven (tuong duong nhung file .jar cua add2num-core).
  </description>

  <dependencies>
    <!-- TASK 2 yeu cau: "tai su dung ket qua Task 1 nhu mot sub-module hoac thu vien .jar". -->
    <dependency>
      <groupId>com.caesar.add2num</groupId>
      <artifactId>add2num-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Bootstrap 5.2.0 phuc vu tu classpath => ung dung chay duoc offline, khong phu thuoc CDN. -->
    <dependency>
      <groupId>org.webjars</groupId>
      <artifactId>bootstrap</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>add2num-web</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.caesar.add2num.web.Add2NumWebApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>repackage</id>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
